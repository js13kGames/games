{
  "name": "js13kgames-play",
  "main": "index.ts",
  "workers_dev": false,
  "compatibility_date": "2025-10-11",
  "assets": {
    "directory": "games",
    "binding": "PLAY",
    "run_worker_first": ["/*.html", "/*/"]
  },
  "services": [{
      "binding": "ASSETS",
      "service": "js13kgames-assets"
    }, {
      "binding": "RUNTIME",
      "service": "js13kgames-runtime"
    }
  ]
}
